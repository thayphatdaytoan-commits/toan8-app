# URL gốc khi deploy (không dấu / cuối). Dùng cho canonical, Open Graph, JSON-LD; và để sinh robots.txt + sitemap.xml lúc build.
# Ví dụ Firebase Hosting:
# VITE_SITE_URL=https://thayphatdaytoan-7832c.web.app
# Hoặc domain tùy chỉnh:
# VITE_SITE_URL=https://www.example.com

VITE_SITE_URL=

# Ghi chú: `npm run build` chạy `prebuild` → tạo public/og-image.png từ public/og-source.svg (cần sharp).
# Sau build, `postbuild` chạy Playwright để ghi lại dist/index.html (prerender). Bỏ qua: SKIP_PRERENDER=1
# Đổi khối snapshot prerender (mặc định 11): PRERENDER_GRADE=9
