rules_version = '2';
// Triển khai: firebase deploy --only firestore
// — Học sinh đọc sơ đồ không cần đăng nhập (tránh lỗi khi Anonymous Auth lỗi / chậm).
// — Ghi vẫn cần request.auth (ẩn danh hoặc tài khoản admin).
service cloud.firestore {
  match /databases/{database}/documents {
    match /math_mindmap_geometry9_v1/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
